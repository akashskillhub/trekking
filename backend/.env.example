DATABASE_LOCAL_URL=postgresql://postgres:password@localhost:5432/pgauth
DATABASE_LIVE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

NODE_ENV=development

FRONTEND_LOCAL_URL=http://localhost:5173
FRONTEND_LIVE_URL=https://your-frontend.example.com

PORT=5000

DB_HOST=localhost
DB_USER=postgres
DB_DATABASE=pgauth
DB_PASSWORD=password
DB_PORT=5432

OTP_EXPIRY_SECONDS=60
JWT_SECRET=your-jwt-secret

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
EMAIL=your-email@example.com
EMAIL_PASS=your-email-app-password
SMS_API_KEY=your-sms-api-key
